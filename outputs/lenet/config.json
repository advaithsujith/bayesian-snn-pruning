{
  "name": "lenet",
  "snn": {
    "num_steps": 25,
    "beta": 0.95,
    "threshold": 1.0,
    "spike_grad": "atan"
  },
  "bayesian": {
    "log_alpha_init": -3.0,
    "log_alpha_clamp_min": -8.0,
    "log_alpha_clamp_max": 8.0,
    "prune_threshold": 3.0,
    "beta_max": 0.4,
    "kl_warmup_epochs": 50,
    "bayesian_train_epochs": 75,
    "bayesian_train_lr": 0.0005
  },
  "bio": {
    "keep_fractions": [
      0.1
    ],
    "naive_num_passes": 1,
    "sca_epochs_per_cycle": 5,
    "sca_num_cycles": 6,
    "sca_lr": 0.0005,
    "sca_weight_decay": 5e-05,
    "dpap_train_epochs": 30,
    "dpap_ema_decay": 0.9,
    "dpap_survival_decay": 0.02,
    "dpap_lr": 0.0005,
    "dpap_weight_decay": 5e-05
  },
  "train": {
    "epochs": 60,
    "batch_size": 128,
    "lr": 0.001,
    "weight_decay": 5e-05,
    "optimizer": "adam",
    "lr_scheduler": "cosine",
    "grad_clip_norm": 5.0,
    "use_amp": true
  },
  "finetune": {
    "epochs": 20,
    "batch_size": 128,
    "lr": 0.0002,
    "weight_decay": 5e-05,
    "optimizer": "adam",
    "lr_scheduler": "cosine",
    "grad_clip_norm": 5.0,
    "use_amp": true
  },
  "data": {
    "data_dir": "./data",
    "val_fraction": 0.1,
    "num_workers": 4,
    "pin_memory": true,
    "random_crop_padding": 4,
    "horizontal_flip_prob": 0.5,
    "normalize_mean": [
      0.4914,
      0.4822,
      0.4465
    ],
    "normalize_std": [
      0.247,
      0.2435,
      0.2616
    ]
  },
  "seed": 42,
  "device": "cuda",
  "num_classes": 10,
  "checkpoint_dir": "./checkpoints",
  "output_dir": "./outputs/lenet",
  "log_dir": "./logs",
  "plot_dir": "./plots",
  "latency_num_warmup": 10,
  "latency_num_runs": 100,
  "latency_batch_size": 1
}